#!/bin/sh

# Lint staged files before committing (see scripts/lint.ts).
#
# Registered with “git config core.hooksPath .githooks”, which “npm install”
# runs through the prepare script in package.json unless npm is configured to
# ignore scripts.

set -o errexit
set -o nounset

staged=$(git diff --cached --name-only --diff-filter=ACMR)

if [ -z "$staged" ]; then
  exit 0
fi

printf '%s\n' "$staged" | tr '\n' '\0' | xargs -0 node scripts/lint.ts
